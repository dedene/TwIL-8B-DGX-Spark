# Copy to .env and uncomment what you want to change; `docker compose up -d --wait` picks it up.
# The values shown are the defaults baked into compose.yaml and tools/serve.sh.

# Weights: balanced (the card's default, shorter reasoning) ships as Q4_K_M only. verbose ships as Q4_K_M (5.35 GB),
# Q8_0 (9.35) and F16 (17.6).
#VARIANT=balanced
#QUANT=Q4_K_M

# Speculative decoding: none or ngram (lossless: the model checks every drafted token).
#SPEC=none

# Context size llama-server allocates, shared by all slots (native window: 131072). KV costs about 164 KB per token,
# so 131072 tokens take about 21 GB.
#CONTEXT=131072
# Server slots. Raise for concurrent requests. spark-bench-kit keeps 4 in flight: PARALLEL=4.
#PARALLEL=1
# Prompt-processing micro-batch.
#UBATCH=2048

# Sampling from the model card. Requests can override per call.
#TEMP=1.0
#TOP_P=0.95
#TOP_K=0
#MIN_P=0

#SERVED_NAME=twil-8b
#HOST=0.0.0.0
#PORT=8888
# Set to require a bearer token on the API.
#API_KEY=
# no, or unless-stopped to come back after a reboot. Only one recipe on port 8888 should set this.
#RESTART=no

#MODEL_ID=webAI-Official/TwIL-8B
#MODEL_REVISION=58d49f0d9909e62f9c2fb09e99fc5c76f3f2d630
# The arm64 CUDA 13 image.
#LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda13@sha256:71f26c2ef2f336418cd42d617db8e479a738a0b9283e327add00e4de633cccfd

#MODEL_DIR=~/.cache/twil-8b
# Only needed if the model ever becomes gated.
#HF_TOKEN=
